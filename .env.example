# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Get the Supabase values from your project: Settings -> API.

# Supabase project URL, e.g. https://xxxx.supabase.co (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key (safe to expose to the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. SECRET: server only, bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Vercel Blob token for uploaded photos in production/preview.
# Leave unset locally: photos are then saved to a git-ignored .data/ folder.
BLOB_READ_WRITE_TOKEN=

# Optional. Invite link for the E-Cell WhatsApp community (https://chat.whatsapp.com/... or https://wa.me/...).
# Read at build time, so redeploy after setting it. Leave empty until the community exists: the footer then
# shows a disabled "Coming soon" button and the homepage banner button is hidden.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
